rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email == '1987zinwaimin@gmail.com'
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Staff profiles are used only by the Owner's account management screen.
    // Staff can create their own pending profile, but cannot approve or change roles.
    match /staffProfiles/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'name', 'department', 'status', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.department in [
          'sales', 'entry', 'playing', 'event', 'leader'
        ]
        && request.resource.data.status == 'pending';

      allow read: if isOwner()
        || (signedIn() && request.auth.uid == uid);

      allow update, delete: if isOwner();
    }

    // The Owner-only delete-password hash/salt lives in this collection.
    match /ownerSettings/{settingId} {
      allow read, write: if isOwner();
    }

    // This version of the app stores tickets, images, quantities and reports
    // in this browser's local storage. Do not pretend those are cloud collections.
    // Deny all other Firestore paths until a verified cloud-sync schema is deployed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
