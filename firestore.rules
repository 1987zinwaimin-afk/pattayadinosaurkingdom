rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      // Owner access is restricted to the exact allowlisted Firebase Email/Password account.
      // Do not block Owner data sync solely because the email_verified claim is stale/false.
      return signedIn()
        && request.auth.token.email == '1987zinwaimin@gmail.com';
    }
    function profilePath(uid) {
      return /databases/$(database)/documents/staffProfiles/$(uid);
    }
    function hasApprovedProfile() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.status == 'approved';
    }
    function profile() {
      return get(profilePath(request.auth.uid)).data;
    }
    function canUseDepartment(department) {
      return isOwner()
        || (hasApprovedProfile()
          && (profile().department == 'leader'
            || profile().department == department));
    }
    function validDepartment(department) {
      return department in ['sales', 'entry', 'playing', 'event'];
    }

    // Staff submit a pending profile. Only the Owner can approve/change roles.
    match /staffProfiles/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'department', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.department in ['sales', 'entry', 'playing', 'event', 'leader']
        && request.resource.data.status == 'pending';
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow update, delete: if isOwner();
    }

    // Cloud ticket records are scoped by department. Staff/Leader cannot delete.
    match /tickets/{ticketId} {
      allow read: if isOwner()
        || (resource.data.department is string
          && canUseDepartment(resource.data.department));
      allow create: if isOwner()
        || (hasApprovedProfile()
          && validDepartment(request.resource.data.department)
          && canUseDepartment(request.resource.data.department));
      allow update: if isOwner()
        || (hasApprovedProfile()
          && validDepartment(resource.data.department)
          && request.resource.data.department == resource.data.department
          && canUseDepartment(resource.data.department));
      allow delete: if isOwner();
    }

    // Daily quantities and report data follow the same department boundary.
    match /daily/{recordId} {
      allow read: if isOwner()
        || (resource.data.department is string
          && canUseDepartment(resource.data.department));
      allow create, update: if isOwner()
        || (hasApprovedProfile()
          && validDepartment(request.resource.data.department)
          && canUseDepartment(request.resource.data.department));
      allow delete: if isOwner();
    }
    match /reports/{reportId} {
      allow read: if isOwner()
        || (resource.data.department is string
          && canUseDepartment(resource.data.department));
      allow create, update: if isOwner()
        || (hasApprovedProfile()
          && validDepartment(request.resource.data.department)
          && canUseDepartment(request.resource.data.department));
      allow delete: if isOwner();
    }
    match /images/{imageId} {
      allow read: if isOwner()
        || (resource.data.department is string
          && canUseDepartment(resource.data.department));
      allow create, update: if isOwner()
        || (hasApprovedProfile()
          && validDepartment(request.resource.data.department)
          && canUseDepartment(request.resource.data.department));
      allow delete: if isOwner();
    }


    // Staff directory tracks UID-based usage; Owner can revoke and remove an account.
    match /staffDirectory/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/revokedStaff/$(uid))
        && request.resource.data.keys().hasOnly(['uid', 'name', 'department', 'createdAt', 'lastSeenAt', 'lastSeenClientTime', 'loginCount', 'source'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.department in ['sales', 'entry', 'playing', 'event', 'leader']
        && request.resource.data.loginCount is int
        && request.resource.data.loginCount >= 1
        && request.resource.data.source == 'staff-share-link';
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow update: if signedIn()
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/revokedStaff/$(uid))
        && request.resource.data.keys().hasOnly(['uid', 'name', 'department', 'createdAt', 'lastSeenAt', 'lastSeenClientTime', 'loginCount', 'source'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.department in ['sales', 'entry', 'playing', 'event', 'leader']
        && request.resource.data.loginCount is int
        && request.resource.data.loginCount >= 1
        && request.resource.data.source == 'staff-share-link';
      allow delete: if isOwner();
    }

    // Revocation records prevent a removed anonymous UID from recreating its directory entry.
    match /revokedStaff/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isOwner();
    }

    // Staff check-in events: any authenticated user may create only their own
    // limited event; only the verified Owner may read the history.
    match /staffLoginEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'department', 'uid', 'createdAt', 'clientTime', 'source'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.department in ['sales', 'entry', 'playing', 'event']
        && request.resource.data.source == 'staff-share-link';
      allow read: if isOwner();
      allow update, delete: if false;
    }

    // Shared ticket catalog: all signed-in sessions can read; only verified Owner can publish.
    match /sharedTicketCatalog/{catalogId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner();
    }

    match /sharedDaily/{recordId} {
      // Signed-in staff need shared quantity reads for cross-device updates.
      allow read: if signedIn();
      // Validate writes and bind them to the authenticated Firebase user.
      // Department-level authorization needs a trusted role/profile, not localStorage.
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'ticketId', 'departmentId', 'date', 'quantity', 'notes', 'updatedAt', 'sourceUid', 'sourceName'])
        && request.resource.data.keys().hasAll(['id', 'ticketId', 'departmentId', 'date', 'quantity', 'sourceUid', 'sourceName'])
        && request.resource.data.id == recordId
        && request.resource.data.departmentId in ['sales', 'entry', 'playing', 'event']
        && request.resource.data.ticketId is string
        && request.resource.data.ticketId.size() > 0
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && request.resource.data.sourceUid == request.auth.uid
        && request.resource.data.sourceName is string
        && request.resource.data.sourceName.size() <= 80
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000));
      allow delete: if isOwner();
    }

    // Shared Leader approval hash: signed-in staff can retrieve the salted hash to verify
    // the password; only the allowlisted Owner can create/update/delete it.
    match /settings/{settingId} {
      allow read: if signedIn() && settingId == 'leaderApproval';
      allow create, update, delete: if isOwner() && settingId == 'leaderApproval';
    }

    // Deny every unlisted collection by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
