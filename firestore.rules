rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn()
        && request.auth.token.email == '1987zinwaimin@gmail.com';
    }
    function profilePath(uid) {
      return /databases/$(database)/documents/staffProfiles/$(uid);
    }
    function hasApprovedProfile() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.status == 'approved';
    }
    function profile() {
      return get(profilePath(request.auth.uid)).data;
    }
    function canUseDepartment(departmentId) {
      return isOwner()
        || (hasApprovedProfile()
          && (profile().department == 'leader'
            || profile().department == departmentId));
    }
    function validDepartment(departmentId) {
      return departmentId in ['sales', 'entry', 'playing', 'event'];
    }

    // Staff submit a pending profile. Only the Owner can approve/change roles.
    match /staffProfiles/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'department', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.department in ['sales', 'entry', 'playing', 'event', 'leader']
        && request.resource.data.status == 'pending';
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow update, delete: if isOwner();
    }

    // Match the app's existing local schema: ticket records use departmentId.
    // Staff/Leader can read and write only their approved department; only Owner can delete.
    match /tickets/{ticketId} {
      allow read: if isOwner()
        || (resource.data.departmentId is string
          && canUseDepartment(resource.data.departmentId));
      allow create: if isOwner()
        || (hasApprovedProfile()
          && validDepartment(request.resource.data.departmentId)
          && canUseDepartment(request.resource.data.departmentId));
      allow update: if isOwner()
        || (hasApprovedProfile()
          && validDepartment(resource.data.departmentId)
          && request.resource.data.departmentId == resource.data.departmentId
          && canUseDepartment(resource.data.departmentId));
      allow delete: if isOwner();
    }

    // Daily quantity and report documents also use departmentId in app.js.
    match /daily/{recordId} {
      allow read: if isOwner()
        || (resource.data.departmentId is string
          && canUseDepartment(resource.data.departmentId));
      allow create: if isOwner()
        || (hasApprovedProfile()
          && validDepartment(request.resource.data.departmentId)
          && canUseDepartment(request.resource.data.departmentId));
      allow update: if isOwner()
        || (hasApprovedProfile()
          && validDepartment(resource.data.departmentId)
          && request.resource.data.departmentId == resource.data.departmentId
          && canUseDepartment(resource.data.departmentId));
      allow delete: if isOwner();
    }
    match /reports/{reportId} {
      allow read: if isOwner()
        || (resource.data.departmentId is string
          && canUseDepartment(resource.data.departmentId));
      allow create: if isOwner()
        || (hasApprovedProfile()
          && validDepartment(request.resource.data.departmentId)
          && canUseDepartment(request.resource.data.departmentId));
      allow update: if isOwner()
        || (hasApprovedProfile()
          && validDepartment(resource.data.departmentId)
          && request.resource.data.departmentId == resource.data.departmentId
          && canUseDepartment(resource.data.departmentId));
      allow delete: if isOwner();
    }
    match /images/{imageId} {
      allow read: if isOwner()
        || (resource.data.departmentId is string
          && canUseDepartment(resource.data.departmentId));
      allow create: if isOwner()
        || (hasApprovedProfile()
          && validDepartment(request.resource.data.departmentId)
          && canUseDepartment(request.resource.data.departmentId));
      allow update: if isOwner()
        || (hasApprovedProfile()
          && validDepartment(resource.data.departmentId)
          && request.resource.data.departmentId == resource.data.departmentId
          && canUseDepartment(resource.data.departmentId));
      allow delete: if isOwner();
    }

    // Owner-only settings such as the separate delete-protection password hash.
    match /ownerSettings/{settingId} {
      allow read, write: if isOwner();
    }

    // Deny every unlisted collection by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
